# Copy to backend/.env (git-ignored). Read by app/core/config.py.

# local | staging | production
ENV=local
LOG_LEVEL=INFO

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=ngx
TRADES_COLLECTION=tradesData

# auto: daily_bars from its first trade date, tradesData before it (ADR-007)
# trades: always aggregate tradesData (parity checks); daily_bars: daily_bars only
BARS_SOURCE=auto

# ── accounts (P2) ──
# invite (launch) | open (self-serve sign-up, ADR-013)
SIGNUP_MODE=invite
# Signs CSRF tokens. Required outside ENV=local:  python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=
# Where email links point (the React app)
PUBLIC_BASE_URL=http://localhost:5173
INVITE_TTL_DAYS=7
# Keep the Streamlit app's PBKDF2 fields in step until cutover (D-17)
LEGACY_PASSWORD_SYNC=true

# console (local: emails are logged, links included) | resend (staging/production)
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM=EquityLensNG <no-reply@localhost>
# Optional: a monitored inbox for replies
# EMAIL_REPLY_TO=
# Optional: logo URL for email templates (default: PUBLIC_BASE_URL/email-assets/… when PUBLIC_BASE_URL is https)
# EMAIL_LOGO_URL=

# Built SPA to serve at "/" (defaults to ../frontend/dist; skipped if missing)
# FRONTEND_DIST=
